{
  "name": "adaiyalam-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Adaiyalam - a website technology detector",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "cli": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.24.2": true
  }
}
